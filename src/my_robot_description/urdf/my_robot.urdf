<?xml version="1.0"?>
<robot name="my_robot">

	<link name="base_link">
		<visual>
			<geometry>
				<box size="0.5 0.5 0.2"/>
			</geometry>
			<material name="blue">
				<color rgba="0.1 0.2 0.8 1.0"/>
			</material>
		</visual>
	</link>

	<link name="upper_link">
		<visual>
			<origin xyz="0 0 0.5" rpy="0 0 0"/>
			<geometry>
				<cylinder radius="0.08" length="1.0"/>
			</geometry>
			<material name="red">
				<color rgba="0.8 0.1 0.1 1.0"/>				
			</material>
		</visual>
	</link>

	<joint name="base_to_upper" type="revolute">
		<parent link="base_link"/>
		<child link="upper_link"/>
		<origin xyz="0 0 0.1" rpy="0 0 0"/>
		<axis xyz="0 0 1"/>

		<limit
			lower="-1.57"
			upper="1.57"
			effort="10"
			velocity="1.0"
		/>	
	</joint>
</robot>
