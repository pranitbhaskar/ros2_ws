<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="base_size" value="0.5"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="arm_length" value="1.0"/>
    <xacro:property name="arm_radius" value="0.08"/>

<xacro:macro name="box_link" params="link_name size height">    
    <link name="${link_name}">
        <visual>
            <geometry>
                <box size="${size} ${size} ${height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
    </link>
</xacro:macro>

<xacro:macro name="cylinder_link" params="link_name length radius">
    <link name="${link_name}">
        <visual>
            <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${radius}" length="${length}"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        
    </link>
    
</xacro:macro>

<xacro:box_link
    link_name="base_link"
    size="${base_size}"
    height="${base_height}"/>

<xacro:cylinder_link
    link_name="upper_link"
    length="${arm_length}"
    radius="${arm_radius}"/>

<xacro:cylinder_link
    link_name="forearm_link"
    length="${arm_length}"
    radius="${arm_radius}"/>

    <joint name="base_to_upper" type="revolute">
        <parent link="base_link"/>
        <child link="upper_link"/>
        <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>  
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <joint name="upper_to_forearm" type="revolute">
        <parent link="upper_link"/>
        <child link="forearm_link"/>
        <origin xyz="0 0 ${arm_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>        
    </joint>
</robot>
